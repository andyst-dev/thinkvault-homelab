# Copy this file to .env and adapt it to the host.
# Do not commit .env.

PUID=1000
PGID=1000
TZ=Etc/UTC

CONFIG_ROOT=/opt/media-stack
MEDIA_ROOT=/data/media
DOWNLOADS_ROOT=/data/downloads
HOST_STORAGE_ROOT=/data

# Use 127.0.0.1 when every web interface is accessed through a reverse proxy
# or SSH tunnel. Use 0.0.0.0 only on a trusted LAN protected by a firewall.
BIND_ADDRESS=127.0.0.1

JELLYFIN_PORT=8096
QBITTORRENT_WEBUI_PORT=8080
QBITTORRENT_PEER_PORT=6881
DASHDOT_PORT=61208
